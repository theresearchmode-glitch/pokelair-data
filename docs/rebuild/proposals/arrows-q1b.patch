 .bx-name{text-align:center}.bx-name h2{font-size:var(--t28);margin:0}.bx-name p{margin:var(--s1) 0 0;font-size:var(--t13);color:var(--ink-2)}
 .bx-arr{width:var(--tap);height:var(--tap);border-radius:50%;border:0;background:var(--surface);color:var(--ink);box-shadow:0 1px 2px rgba(var(--shade),.14),0 4px 10px -4px rgba(var(--shade),.3);cursor:pointer;font-size:var(--t13)}
 :root[data-theme="night"] .bx-arr{background:var(--wash)}
