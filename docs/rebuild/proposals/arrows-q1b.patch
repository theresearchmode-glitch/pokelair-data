+.bx-arr{border-radius:0;transform:skewX(-12deg);border:1.5px solid var(--ink);box-shadow:none}.bx-arr span{display:inline-block;transform:skewX(12deg)}
+:root[data-theme="night"] .bx-arr{border-color:color-mix(in srgb,var(--ink) 42%,transparent)}
 .bx-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:var(--s1) var(--s1)}
 @container (max-width:560px){.bx-grid{grid-template-columns:repeat(5,minmax(0,1fr))}}
 .bx-t{position:relative;display:flex;flex-direction:column;align-items:center;gap:var(--s1);min-width:0;padding:var(--s2) var(--s1) var(--s2);border:0;border-radius:10px;background:none;color:var(--ink);cursor:pointer;transition:transform .15s,background-color .15s,box-shadow .15s}
