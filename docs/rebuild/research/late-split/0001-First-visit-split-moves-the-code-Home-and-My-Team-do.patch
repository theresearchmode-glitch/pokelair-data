index 00000000..99306f5c
--- /dev/null
+++ b/app/src/v2/late.js
@@ -0,0 +1,50 @@
+// ---------- Late code (--split builds only; first-visit speed change 3, Nov 18; docs/rebuild/research/first-visit-nov18.md) ----------
+// The build moves the files Home and My Team don't need at start (parts-v2.json "late") into v2-late.js, loaded after the first
+// screen. This file is added by app/build.mjs with --split only (never in the one-file build the tests and CI read); the build puts
+// V2.LATE in front of it: {url, pages: {route: place}, props: [V2 names the late files set], clicks: [data-* only late code handles]}.
+// - A page whose code is late is a small stand-in until the file arrives: it shows the site's loading panel, asks for the file, and
+//   the page draws when it lands (deep links like #calc or #pokemon=... on a cold load go the same way).
+// - Anything else on the site that needs late code before it has arrived (a V2.x the late files set, or one of their names; see
+//   app/split-late.mjs) loads the file at once, synchronously, so it is never missing. V2.lateSync counts those (the checks expect 0
+//   at start on Home and My Team).
+// - Otherwise the file is asked for when the page is idle after today's numbers are drawn, or at the first tap or key press.
+V2.lateState = 0; /* 0 not asked, 1 loading, 2 running, 3 ready, 4 failed */ V2.lateSync = 0; V2.lateExp = null;
+V2.lateRun = () => { if (V2.lateState >= 2 && V2.lateState !== 4) return; const f = window.__NP_LATE; if (typeof f !== 'function') throw new Error('v2-late.js did not define its code');
+  V2.lateState = 2; try { V2.lateExp = f(V2.lateScope()); V2.lateState = 3; } catch (e) { V2.lateState = 4; throw e; } };
+V2.lateDone = () => { if (V2._lateWas) { V2._lateWas = 0; V2.redraw(); } }; /* a stand-in was on screen: draw the page (or say it failed) */
+V2.loadLate = () => { if (V2._lateP) return V2._lateP;
+  V2._lateP = new Promise((ok, no) => { if (V2.lateState === 3) { ok(); return; }
+    if (typeof window.__NP_LATE === 'function') { try { V2.lateRun(); ok(); } catch (e) { console.error(e); no(e); } V2.lateDone(); return; } /* already fetched by V2.lateNow */
+    V2.lateState = 1; const s = document.createElement('script'); s.src = V2.LATE.url; s.async = true;
+    s.onload = () => { try { V2.lateRun(); ok(); } catch (e) { console.error(e); no(e); } V2.lateDone(); };
+    s.onerror = () => { if (V2.lateState < 2) { V2.lateState = 4; V2.lateDone(); } no(new Error('v2-late.js could not be loaded')); };
+    document.head.appendChild(s); });
+  V2._lateP.catch(() => {}); return V2._lateP; };
+// the synchronous way in, for code that needs a late name right now (never at start on Home or My Team: checked)
+V2.lateNow = () => { if (V2.lateState === 3 || V2.lateState === 2) return V2.lateExp || {};
+  if (!V2.lateScope) { console.error('late code needed before the main script finished'); (window.__NP_LATE_EARLY = window.__NP_LATE_EARLY || []).push('V2'); return {}; } /* a late file the start needs: keep it in the main script */
+  V2.lateSync++; try { (V2.lateSyncWhy = V2.lateSyncWhy || []).push(String(new Error('late code needed early').stack).split('\n').slice(2, 6).join(' | ')); } catch (e) {}
+  try { if (typeof window.__NP_LATE !== 'function') { const x = new XMLHttpRequest(); x.open('GET', V2.LATE.url, false); x.send();
+    if (x.status && x.status !== 200) throw new Error('v2-late.js: ' + x.status); const s = document.createElement('script'); s.text = x.responseText; document.head.appendChild(s); }
+    V2.lateRun(); } catch (e) { console.error(e); } return V2.lateExp || {}; };
+// the V2 names the late files set: reading one before the file is in loads it first; the late file's own assignment replaces the stand-in
+for (const k of V2.LATE.props) if (!(k in V2)) Object.defineProperty(V2, k, {configurable: true, enumerable: true,
+  get() { if (V2.lateState !== 2) V2.lateNow(); return Object.getOwnPropertyDescriptor(V2, k).get ? undefined : V2[k]; },
