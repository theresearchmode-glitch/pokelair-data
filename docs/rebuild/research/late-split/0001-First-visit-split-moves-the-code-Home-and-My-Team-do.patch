index 00000000..c7b6e0d6
--- /dev/null
+++ b/app/split-late.mjs
@@ -0,0 +1,60 @@
+// --split, part 3 (Nov 18, first-visit speed change 3; docs/rebuild/research/first-visit-nov18.md): the files listed in parts-v2.json
+// "late" leave the main script and go in dist/v2-late.js, loaded after the first screen (src/v2/late.js is the loader).
+// The site's code is one closure, so the late files can't see its names by themselves. esbuild (already used by the build) does the
+// scope work, so nothing is guessed from the text:
+//  - late code -> main: each main top-level name the late code uses is rewritten to __m.<name> (esbuild `define` replaces only free
+//    names, never a local of the same name). __m is V2.lateScope(), made inside the closure: plain values for functions and consts
+//    nobody reassigns, live getters and setters for everything else.
+//  - main -> late: each late top-level name the main code uses is rewritten to __LX.<name>; __LX reads it from the late code's
+//    exports, loading the file first if it isn't in yet (V2.lateNow). The checks expect this never to happen at start on Home or My Team.
+//  - V2.x set only by late files: src/v2/late.js puts a stand-in on V2 that loads the file first when read (V2.LATE.props).
+// Only used with --split; the one-file build never reads this module.
+const RES = new Set(('break case catch class const continue debugger default delete do else export extends false finally for function if import in instanceof new null ' +
+  'return super switch this throw true try typeof var void while with yield let static enum await implements package protected interface private public arguments eval ' +
+  'undefined NaN Infinity async of get set').split(' '));
+const toks = s => [...new Set(s.match(/[A-Za-z_$][\w$]*/g))].filter(t => !RES.has(t) && !t.startsWith('__FREE_'));
+const def = names => Object.fromEntries(names.map(n => [n, '__FREE_' + n]));
+// names among `names` that are bound at the top of `body` (a function body that is closed by `tail`): a probe array at its end
+function topBound(esb, body, names, tail) {
+  if (!names.length) return new Set();
+  const out = esb.transformSync(body + '\n;__PROBE__=[' + names.join(',') + '];\n' + tail, {define: def(names), logLevel: 'silent'}).code, i = out.lastIndexOf('__PROBE__ = [');
+  const arr = out.slice(i + 13, out.indexOf(']', i)).split(',').map(s => s.trim());
+  if (i < 0 || arr.length !== names.length) throw new Error('split-late: probe failed'); return new Set(names.filter((n, k) => !arr[k].startsWith('__FREE_'))); }
+function freeIn(esb, code, names) { if (!names.length) return new Set(); const out = esb.transformSync(code, {define: def(names), logLevel: 'silent'}).code;
+  return new Set([...out.matchAll(/__FREE_([A-Za-z_$][\w$]*)/g)].map(m => m[1])); }
+const reEsc = s => s.replace(/\$/g, '\\$');
+/* mainBody: the closure's code from "(function(){" up to (not including) the final "})();"; lateBody: the late files joined.
+   Returns what the build needs: the late file's text, the defines for the main script, and the code to add inside the closure. */
+export function splitLate(esb, {mainBody, lateBody, lateSrcs, mainSrcs, url}) {
+  // late -> main
+  const lateFree = freeIn(esb, '(function(){\n' + lateBody + '\n})();', toks(lateBody));
+  const mainTop = [...topBound(esb, mainBody, [...lateFree], '})();')].sort();
+  const allSrc = mainSrcs.join('\n') + '\n' + lateSrcs.join('\n');
+  const fixed = n => { const e = reEsc(n), decl = mainSrcs.some(s => new RegExp('^(?:async\\s+)?function\\s+' + e + '\\s*\\(', 'm').test(s) || new RegExp('^const\\s+' + e + '\\s*=', 'm').test(s));
+    if (!decl) return false; /* a function nobody reassigns, or a const: a plain value is the same thing */
+    return !new RegExp('(?:^|[^.\\w$])' + e + '\\s*(?:[-+*/%&|^]|\\*\\*|<<|>>>?|&&|\\|\\||\\?\\?)?=(?!=)|(?:\\+\\+|--)\\s*' + e + '\\b|(?:^|[^.\\w$])' + e + '\\s*(?:\\+\\+|--)', 'm').test(allSrc.replace(new RegExp('^(?:async\\s+)?function\\s+' + e + '\\s*\\(|^const\\s+' + e + '\\s*=', 'gm'), '')); };
+  const scope = 'V2.lateScope=()=>({' + mainTop.map(n => fixed(n) ? n : `get ${n}(){return ${n}},set ${n}(v){${n}=v}`).join(',') + '});';
+  // main -> late
+  const lateTop = [...topBound(esb, '(function(){\n' + lateBody, toks(lateBody), '})();')];
+  const used = [...freeIn(esb, mainBody + '\n})();', lateTop)].sort();
+  const mainDefine = Object.fromEntries(used.map(n => [n, '__LX.' + n]));
+  /* __LXG: before the main script has finished (V2.lateScope is made last) the late code can't run at all; that would be a file listed as
+     late that the start needs, so it is said loudly (console error) and the checks fail on it; the fix is to keep that file in the main script */
+  const lx = 'const __LX={' + used.map(n => `get ${n}(){return __LXG('${n}').${n}},set ${n}(v){__LXG('${n}').${n}=v}`).join(',') + '};' +
+    'function __LXG(n){const V=window.V2;if(!V||!V.lateScope){console.error("late code needed before the main script finished: "+n);(window.__NP_LATE_EARLY=window.__NP_LATE_EARLY||[]).push(n);return {};}return V.lateNow();}';
+  const exp = 'return {' + used.map(n => `get ${n}(){return ${n}},set ${n}(v){${n}=v}`).join(',') + '};';
+  // the late file: one function the loader calls with V2.lateScope()
+  const lateDefine = Object.fromEntries(mainTop.map(n => [n, '__m.' + n]));
+  const late = esb.transformSync('window.__NP_LATE=function(__m){\n' + lateBody + '\n' + exp + '\n};', {define: lateDefine, minifyWhitespace: true, charset: 'utf8', legalComments: 'none', logLevel: 'silent'}).code;
+  // V2 names only the late files set, and the late pages with their menu place
+  const setIn = s => new Set([...s.matchAll(/V2\.([A-Za-z_$][\w$]*)\s*=(?!=)/g)].map(m => m[1]));
+  const mainSet = setIn(mainSrcs.join('\n')), props = [...setIn(lateBody)].filter(k => !mainSet.has(k) && k !== 'pages').sort();
+  const pages = {}; for (const m of lateBody.matchAll(/V2\.pages(?:\.([\w$]+)|\[['"]([\w$-]+)['"]\])\s*=\s*(\{\s*place:\s*'([^']*)')?/g)) pages[m[1] || m[2]] = m[4] || '';
+  // the data-* attributes only the late files' click code looks for: a tap on one before the file lands waits for it, then happens
+  const sel = s => new Set([...s.matchAll(/(?:closest|matches)\(\s*['"`]([^'"`]*)['"`]/g)].flatMap(m => [...m[1].matchAll(/\[(data-[\w-]+)/g)].map(x => x[1])));
+  const mainSrc = mainSrcs.join('\n'), clicks = new Set([...sel(lateBody)].filter(a => !new RegExp('\\[' + a + '[\\]=~^$*|]').test(mainSrc)));
+  /* and the main script's own click code that reaches late code (Home's "Prep for this team" sets Battle's opponent, V2.btSetOpp): its
+     taps wait for the file too, instead of loading it synchronously. A statement is a line starting at column 0 plus its indented lines. */
+  const needs = new RegExp('V2\\.(?:' + props.map(reEsc).join('|') + ')\\b' + (used.length ? '|(?:^|[^.\\w$])(?:' + used.map(reEsc).join('|') + ')\\b' : ''));
+  for (const s of mainSrcs) for (const st of s.split(/\n(?=\S)/)) if (/addEventListener\(\s*['"]click['"]/.test(st) && props.length && needs.test(st)) for (const a of sel(st)) clicks.add(a);
+  return {late, mainDefine, lx, scope, info: {mainTop: mainTop.length, fixed: mainTop.filter(fixed).length, used, props, pages, clicks: [...clicks].sort()}}; }
