--- a/app/src/v2/css/pages.css
+++ b/app/src/v2/css/pages.css
@@ -4528,3 +4528,46 @@
   .dr .k-plan>.k-step>.k-sec{margin-top:var(--s10)}
   .dr .tp-piles{gap:var(--s6)}
 }
+/* Speed Tiers option A at 1280-1439 (alt/len1280b, Nov 24): each blue band reads as one line plus its "outspeeds" line: the Yours tag
+   (and a Mega's "Mega") sit on the name's line instead of on lines of their own; the name column is 320px so "Mega Charizard Y" and
+   its tag fit; the bands keep their bar, sprite and both sentences. Nothing is hidden; 1440 and up, 1100-1279 and phones unchanged */
+@media (min-width:1280px) and (max-width:1439.98px){
+  .sp2-track{--c2c:320px}
+  .sp2-cut .sp2-m{min-height:0;row-gap:var(--s1);padding-block:var(--s1)}
+  .sp2-cut .sp2-bar{top:50%;bottom:auto;translate:0 -50%}
+  .sp2-cut .nm{align-self:center;flex-wrap:nowrap;align-items:center}
+  .sp2-cut .nm b,.sp2-cut .nm .sp2-form{flex-basis:auto}
+}
+/* Test Run option A at 1280-1439 (alt/len1280b, Nov 24): the lede and "How it works" sit to the right of the headline (its second line
+   leaves ~330px free there) instead of under it; in the piles, a team you answer all six of reads on one line (place, event, "You
+   answer all six.", counts), so those rows drop to the 44px tap height; the page ends 16px under its note (was 64px). Nothing is
+   hidden; 1440 and up, 1100-1279 and phones unchanged */
+@media (min-width:1280px) and (max-width:1439.98px){
+  .tr.dr{grid-template-columns:minmax(0,1fr) 320px;column-gap:var(--s8);padding-bottom:var(--s4)}
+  .tr.dr>*{grid-column:1/-1}
+  .tr.dr>.dr-h{grid-column:1;grid-row:span 2}
+  .tr.dr>.tr-lede,.tr.dr>.tr-how{grid-column:2;align-self:end}
+  .tr.dr>.tr-how{align-self:start}
+  .dr .tp-cards .dr-row:not(:has(.dr-tn)){min-height:var(--tap)}
+  .dr .tp-cards .dr-row:not(:has(.dr-tn)) .dr-id{display:flex;flex-wrap:wrap;align-items:baseline;column-gap:var(--s2)}
+  .dr .tp-cards .dr-row:not(:has(.dr-tn)) .dr-id b{white-space:nowrap}
+  .dr .tp-cards .dr-row:not(:has(.dr-tn)){grid-template-columns:minmax(0,1fr) auto auto}
+}
+/* Events option A at 1280-1439 (alt/len1280b, Nov 24): the ticket wall runs four across (was three) and each ticket puts its date on top
+   as a dark strip (day and month on one line) instead of a stub at its left, so the event name (15px, as on phones) and its six get the
+   ticket's full width. Twelve tickets: three rows of four. The page ends 16px under the wall's Show more (was 96px), 32px over the wall. Nothing is hidden; 1440 and up, 1100-1279 and phones unchanged */
+@media (min-width:1280px) and (max-width:1439.98px){
+  .ev2-wall{grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--s4)}
+  .ev2-wall>.ev2-tk,.ev2-wall.m3-2>.ev2-tk:nth-last-child(-n+2),.ev2-wall.m3-1>.ev2-tk:last-child{grid-column:auto}
+  .ev2-wall .ev2-tk{grid-template-columns:minmax(0,1fr);grid-template-rows:auto 1fr}
+  .ev2-wall .ev2-stub{display:flex;align-items:baseline;justify-content:flex-start;gap:var(--s2);padding:var(--s2) var(--s4);border-right:0;border-bottom:3px dashed var(--k-paper)}
+  .ev2-wall .ev2-stub b{font-size:var(--t24)}
+  .ev2-wall .ev2-body{padding:var(--s3) var(--s4) var(--s4)}
+  .ev2-wall .ev2-six{justify-content:space-between;gap:0}
+  .ev2-wall .ev2-six .np-mon{--iw:36px}
+  .ev2-wall .ev2-stub{padding-block:var(--s1)}.ev2-wall .ev2-stub b{font-size:var(--t22)}
+  .ev2-wall .ev2-body{padding-top:var(--s2)}
+  .ev2-wall .ev2-name{font-size:var(--t15)}
+  .ev2.gsp{padding-bottom:var(--s4)}.ev2 .k-plan{padding-bottom:var(--s2)}
+  .ev2 .k-plan>.k-step:last-child>.k-sec{margin-top:var(--s8)}
+}
